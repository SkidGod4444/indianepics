{
  "name": "indianepics",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "bun scripts/build-content.ts && bun scripts/build-llms.ts && next dev",
    "build": "bun scripts/build-content.ts && bun scripts/build-llms.ts && next build",
    "start": "bunx serve out",
    "lint": "eslint",
    "content": "bun scripts/build-content.ts && bun scripts/build-llms.ts",
    "images": "bun scripts/fetch-images.ts",
    "typecheck": "tsc --noEmit",
    "icons": "bun scripts/gen-icons.ts",
    "voice": "bun scripts/build-content.ts && bun scripts/build-voice.ts",
    "voice:scan": "bun scripts/build-voice.ts --scan"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.1",
    "d3-geo": "^3.1.1",
    "flubber": "^0.4.2",
    "gray-matter": "^4.0.3",
    "lucide-react": "^1.66.0",
    "motion": "^14.9.0",
    "next": "16.4.3",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shadcn": "^4.23.0",
    "topojson-client": "^3.1.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/d3-geo": "^3.1.1",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "license": "MIT"
}
