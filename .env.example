# Public origin of the deployed site. Canonical URLs, Open Graph URLs, sitemap.xml and llms.txt are built from it.
NEXT_PUBLIC_SITE_URL=https://indianepics.online

# Narration (optional). `bun run voice` reads these and writes mp3s to public/audio/. Never needed by `bun run build`.
SARVAM_API_KEY=
# Sarvam bulbul:v4-flash persona IDs (voice_language_style). Audition at https://indus.sarvam.ai/api-playground/text-to-speech
SARVAM_VOICE_EN=varun_en_suspense
SARVAM_VOICE_HI=h_narrator   # toonforge alias; a Sarvam persona ID works too
